# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# --- Azure OpenAI ---
AZURE_API_KEY=
AZURE_API_VERSION=
AZURE_API_ENDPOINT=

# --- Object storage (uploaded PDFs) ---
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for MinIO or another S3-compatible server; leave unset for real AWS S3.
# S3_ENDPOINT_URL=http://localhost:9000

# --- Infrastructure ---
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
VALKEY_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql://rag:rag@localhost:5432/rag

# --- Optional ---
TAVILY_KEY=
TRANSCRIPTION_URL=
